        { "title":"对话数据模式列表", "name":"dialogueDataSchemaList", "type":"Object", "notnull":true }
      ]
    }
  ],
  "routes":[
    { "source":"start", "target":"FLOW_NODE_INITIALIZE_FILE_AND_SCHEMA_LIST_PARAMETERS", "condition":"true" },
    { "source":"FLOW_NODE_INITIALIZE_FILE_AND_SCHEMA_LIST_PARAMETERS", "target":"@com.horsecoder.platform.mall.dialogue/FLOW_GET_DIALOGUE_SCHEMA_LIST", "condition":"true" },
    { "source":"@com.horsecoder.platform.mall.dialogue/FLOW_GET_DIALOGUE_SCHEMA_LIST", "target":"FLOW_NODE_CONVERT_DIALOGUE_DATA_PATTERNS_AND_FILES", "condition":"true" },
    { "source":"FLOW_NODE_CONVERT_DIALOGUE_DATA_PATTERNS_AND_FILES", "target":"FLOW_NODE_DISPATCH_DIALOGUE_DATA_SCHEMA_LIST", "condition":"true" },
    { "source":"FLOW_NODE_DISPATCH_DIALOGUE_DATA_SCHEMA_LIST", "target":"end", "condition":"true" }
  ]
