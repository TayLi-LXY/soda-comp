{
  "id":"@com.horsecoder.platform.mall.umi.chat/leftComponent/FLOW_ON_AUTOMATICALLY_CREATE_A_SESSION_UPON_FIRST_LOGIN",
  "name":"FLOW_ON_AUTOMATICALLY_CREATE_A_SESSION_UPON_FIRST_LOGIN",
  "type":"flow",
  "title":"首次登录自动创建会话",
  "params":[
    { "title":"页面设置器", "name":"setter", "type":"Object", "notnull":true },
    { "title":"WEB状态更新", "name":"dispatch", "type":"Object", "notnull":true },
    { "title":"是否首次登录无会话", "name":"ifFirstLogWithoutConversation", "type":"Object", "notnull":true },
    { "title":"登录用户", "name":"loggedinUser", "type":"Object", "notnull":true }
  ],
  "nodes":[
    {
      "id":"FLOW_NODE_PREPARE_CREATE_SESSION_PARAMETERS",
      "type":"event",
      "title":"准备创建会话参数",
      "reference":"LeftComponent/OnAutomaticallyCreateASessionUponFirstLogin/FLOW_CODE_PREPARE_CREATE_SESSION_PARAMETERS",
      "params":[
        { "title":"登录用户", "name":"loggedinUser", "type":"Object", "notnull":true }
      ],
      "results":[
        { "title":"IM发送用户ID", "name":"imUserId", "type":"String", "notnull":true },
        { "title":"接收人ID列表", "name":"recipientIdList", "type":"List(String)", "notnull":true },
        { "title":"名字", "name":"name", "type":"String", "notnull":true }
      ]
    },
    {
      "id":"FLOW_NODE_SET_GLOBAL_SESSION_AND_U_R_L",
      "type":"event",
      "title":"设置全局会话和url",
      "reference":"LeftComponent/OnAutomaticallyCreateASessionUponFirstLogin/FLOW_CODE_SET_GLOBAL_SESSION_AND_U_R_L",
      "params":[
        { "title":"IM用户对话ID", "name":"imUserConversationId", "type":"String", "notnull":true },
        { "title":"IM会话Id", "name":"imConversationId", "type":"String", "notnull":true },
        { "title":"WEB状态更新", "name":"dispatch", "type":"Object", "notnull":true },
        { "title":"页面设置器", "name":"setter", "type":"Object", "notnull":true }
      ]
    },
    {
      "id":"@com.horsecoder.platform.mall.dialogue/FLOW_CREATE_A_DIALOGUE",
      "type":"flow",
      "title":"创建对话",
      "reference":"@com.horsecoder.platform.mall.dialogue/FLOW_CREATE_A_DIALOGUE",
      "params":[
        { "title":"IM发送用户ID", "name":"imUserId", "type":"String", "notnull":true },
        { "title":"接收人ID列表", "name":"recipientIdList", "type":"List(String)", "notnull":true },
        { "title":"对话类型", "name":"type", "type":"Integer", "notnull":false, "defaultValue":1 },
        { "title":"状态", "name":"status", "type":"Integer", "notnull":false, "defaultValue":0 },
        { "title":"名字", "name":"name", "type":"String", "notnull":true }
      ],
      "results":[
        { "title":"IM用户对话ID", "name":"imUserConversationId", "type":"String", "notnull":true },
        { "title":"IM会话Id", "name":"imConversationId", "type":"String", "notnull":true }
      ]
    }
  ],
  "routes":[
    { "source":"start", "target":"FLOW_NODE_PREPARE_CREATE_SESSION_PARAMETERS", "condition":"true" },
    { "source":"FLOW_NODE_SET_GLOBAL_SESSION_AND_U_R_L", "target":"end", "condition":"true" },
    { "source":"FLOW_NODE_PREPARE_CREATE_SESSION_PARAMETERS", "target":"@com.horsecoder.platform.mall.dialogue/FLOW_CREATE_A_DIALOGUE", "condition":"true" },
    { "source":"@com.horsecoder.platform.mall.dialogue/FLOW_CREATE_A_DIALOGUE", "target":"FLOW_NODE_SET_GLOBAL_SESSION_AND_U_R_L", "condition":"true" }
  ]
}