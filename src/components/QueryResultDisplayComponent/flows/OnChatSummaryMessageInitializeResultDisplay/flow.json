    },
    {
      "id":"FLOW_NODE_SET_FILE_URL",
      "type":"event",
      "title":"设置数据:文件链接",
      "reference":"QueryResultDisplayComponent/OnChatSummaryMessageInitializeResultDisplay/FLOW_CODE_SET_FILE_URL",
      "params":[
        { "title":"页面设置器", "name":"setter", "type":"Object", "notnull":true },
        { "title":"文件链接", "name":"fileUrl", "type":"Object", "notnull":true }
      ]
    },
    {
      "id":"FLOW_NODE_SET_ITEMS",
      "type":"event",
      "title":"设置数据:提示词列表",
      "reference":"QueryResultDisplayComponent/OnChatSummaryMessageInitializeResultDisplay/FLOW_CODE_SET_ITEMS",
      "params":[
        { "title":"页面设置器", "name":"setter", "type":"Object", "notnull":true },
        { "title":"提示词列表", "name":"items", "type":"Object", "notnull":true }
      ]
    }
  ],
  "routes":[
    { "source":"start", "target":"FLOW_NODE_INITIALIZE_RESULT_DISPLAY_WITH_INPUT_PARAMETERS", "condition":"true" },
    { "source":"FLOW_NODE_INITIALIZE_RESULT_DISPLAY_WITH_INPUT_PARAMETERS", "target":"@com.horsecoder.platform.mall.dialogue/FLOW_INITIALIZE_RESULTS_BASED_ON_QUERY_RESULTS_AND_DISPLAYM", "condition":"true" },
    { "source":"@com.horsecoder.platform.mall.dialogue/FLOW_INITIALIZE_RESULTS_BASED_ON_QUERY_RESULTS_AND_DISPLAYM", "target":"FLOW_NODE_THE_CONVERSION_RESULT_DISPLAYS_PARAMETERS", "condition":"true" },
    { "source":"FLOW_NODE_THE_CONVERSION_RESULT_DISPLAYS_PARAMETERS", "target":"FLOW_NODE_SET_SUMMARIZE_CONTENT", "condition":"true" },
    { "source":"FLOW_NODE_SET_SUMMARIZE_CONTENT", "target":"FLOW_NODE_SET_FILE_URL", "condition":"true" },
    { "source":"FLOW_NODE_SET_FILE_URL", "target":"FLOW_NODE_SET_ITEMS", "condition":"true" },
    { "source":"FLOW_NODE_SET_ITEMS", "target":"end", "condition":"true" }
