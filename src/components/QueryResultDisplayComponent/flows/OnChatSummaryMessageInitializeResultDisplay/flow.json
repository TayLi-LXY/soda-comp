      ]
    },
    {
      "id":"FLOW_NODE_THE_CONVERSION_RESULT_DISPLAYS_PARAMETERS",
      "type":"event",
      "title":"转化结果展示出参",
      "reference":"QueryResultDisplayComponent/OnChatSummaryMessageInitializeResultDisplay/FLOW_CODE_THE_CONVERSION_RESULT_DISPLAYS_PARAMETERS",
