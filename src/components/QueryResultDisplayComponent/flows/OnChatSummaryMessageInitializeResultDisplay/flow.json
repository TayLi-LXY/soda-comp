        { "title":"总结消息", "name":"summaryMessage", "type":"String", "notnull":true }
      ]
    },
    {
      "id":"@com.horsecoder.platform.mall.dialogue/FLOW_INITIALIZE_RESULTS_BASED_ON_QUERY_RESULTS_AND_DISPLAYM",
      "type":"flow",
      "title":"根据查询结果初始化结果展示",
      "reference":"@com.horsecoder.platform.mall.dialogue/FLOW_INITIALIZE_RESULTS_BASED_ON_QUERY_RESULTS_AND_DISPLAYM",
      "params":[
