{
  "id":"@com.horsecoder.platform.mall.umi.chat/queryResultDisplayComponent/FLOW_ON_CHAT_SUMMARY_MESSAGE_INITIALIZE_RESULT_DISPLAY",
  "name":"FLOW_ON_CHAT_SUMMARY_MESSAGE_INITIALIZE_RESULT_DISPLAY",
  "type":"flow",
  "title":"根据聊天总结消息初始化结果展示",
  "params":[
    { "title":"页面设置器", "name":"setter", "type":"Object", "notnull":true },
    { "title":"WEB状态更新", "name":"dispatch", "type":"Object", "notnull":true },
    { "title":"是否流式", "name":"ifStream", "type":"Object", "notnull":true },
    { "title":"消息ID", "name":"messageId", "type":"Object", "notnull":true },
    { "title":"消息内容", "name":"messageContent", "type":"Object", "notnull":true }
  ],
  "nodes":[
    {
      "id":"FLOW_NODE_INITIALIZE_RESULT_DISPLAY_WITH_INPUT_PARAMETERS",
