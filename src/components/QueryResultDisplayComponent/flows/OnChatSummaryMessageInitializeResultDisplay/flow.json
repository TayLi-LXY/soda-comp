      "results":[
        { "title":"提示词列表", "name":"items", "type":"Object", "notnull":true }
      ]
    },
    {
      "id":"FLOW_NODE_SET_SUMMARIZE_CONTENT",
      "type":"event",
      "title":"设置数据:总结内容",
      "reference":"QueryResultDisplayComponent/OnChatSummaryMessageInitializeResultDisplay/FLOW_CODE_SET_SUMMARIZE_CONTENT",
      "params":[
