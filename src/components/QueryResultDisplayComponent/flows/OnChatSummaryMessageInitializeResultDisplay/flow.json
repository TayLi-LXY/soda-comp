      "reference":"QueryResultDisplayComponent/OnChatSummaryMessageInitializeResultDisplay/FLOW_CODE_INITIALIZE_RESULT_DISPLAY_WITH_INPUT_PARAMETERS",
      "params":[
        { "title":"消息内容", "name":"messageContent", "type":"Object", "notnull":true }
