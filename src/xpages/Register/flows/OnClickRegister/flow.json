        { "title":"注册手机验证表单", "name":"registrationMobileVerificationForm", "type":"Object", "notnull":true }
      ],
      "results":[
        { "title":"密码", "name":"password", "type":"String", "notnull":true },
        { "title":"手机号", "name":"phone", "type":"String", "notnull":true },
        { "title":"昵称", "name":"nickname", "type":"String", "notnull":true },
        { "title":"邮箱", "name":"email", "type":"String", "notnull":true },
        { "title":"用户类型", "name":"userType", "type":"Integer", "notnull":false, "defaultValue":0 },
        { "title":"验证码", "name":"captcha", "type":"String", "notnull":true },
        { "title":"用户名", "name":"userName", "type":"String", "notnull":true }
      ]
    },
    {
      "id":"@com.horsecoder.platform.mall.dialogue/FLOW_REGISTER",
      "type":"flow",
      "title":"注册",
      "reference":"@com.horsecoder.platform.mall.dialogue/FLOW_REGISTER",
      "params":[
        { "title":"密码", "name":"password", "type":"String", "notnull":true },
        { "title":"手机号", "name":"phone", "type":"String", "notnull":true },
        { "title":"昵称", "name":"nickname", "type":"String", "notnull":true },
        { "title":"邮箱", "name":"email", "type":"String", "notnull":true },
        { "title":"用户名", "name":"userName", "type":"String", "notnull":true },
        { "title":"用户类型", "name":"userType", "type":"Integer", "notnull":false, "defaultValue":0 },
        { "title":"验证码", "name":"captcha", "type":"String", "notnull":true }
