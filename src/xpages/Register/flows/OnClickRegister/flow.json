  "routes":[
    { "source":"start", "target":"FLOW_NODE_ON_CLICK_REGISTER", "condition":"true" },
    { "source":"FLOW_NODE_SUCCESSFULLY_REGISTERED_AND_REDIRECTED_LOGIN", "target":"end", "condition":"true" },
    { "source":"FLOW_NODE_ON_CLICK_REGISTER", "target":"@com.horsecoder.platform.mall.dialogue/FLOW_REGISTER", "condition":"true" },
    { "source":"@com.horsecoder.platform.mall.dialogue/FLOW_REGISTER", "target":"FLOW_NODE_SUCCESSFULLY_REGISTERED_AND_REDIRECTED_LOGIN", "condition":"true" }
  ]
