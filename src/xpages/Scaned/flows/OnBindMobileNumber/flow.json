{
  "id":"@com.horsecoder.platform.mall.umi.chat/scaned/FLOW_ON_BIND_MOBILE_NUMBER",
  "name":"FLOW_ON_BIND_MOBILE_NUMBER",
  "type":"flow",
  "title":"绑定手机号",
  "params":[
    { "title":"页面设置器", "name":"setter", "type":"Object", "notnull":true },
    { "title":"WEB状态更新", "name":"dispatch", "type":"Object", "notnull":true },
    { "title":"注册手机验证表单", "name":"registrationMobileVerificationForm", "type":"Object", "notnull":true }
  ],
  "nodes":[
    {
      "id":"FLOW_NODE_GET_BINDING_PARAMETERS",
      "type":"event",
      "title":"获取绑定参数",
      "reference":"Scaned/OnBindMobileNumber/FLOW_CODE_GET_BINDING_PARAMETERS",
      "params":[
        { "title":"注册手机验证表单", "name":"registrationMobileVerificationForm", "type":"Object", "notnull":true }
      ],
      "results":[
        { "title":"手机号", "name":"phone", "type":"String", "notnull":true },
        { "title":"验证码", "name":"captcha", "type":"String", "notnull":true },
        { "title":"临时token", "name":"tempToken", "type":"String", "notnull":true }
      ]
    },
    {
      "id":"@com.horsecoder.platform.mall.dialogue/FLOW_WE_CHAT_BINDING_PHONE_NUMBER_REGISTRATION",
      "type":"flow",
      "title":"微信绑定手机号注册",
      "reference":"@com.horsecoder.platform.mall.dialogue/FLOW_WE_CHAT_BINDING_PHONE_NUMBER_REGISTRATION",
      "params":[
        { "title":"手机号", "name":"phone", "type":"String", "notnull":true },
        { "title":"验证码", "name":"captcha", "type":"String", "notnull":true },
        { "title":"临时token", "name":"tempToken", "type":"String", "notnull":true }
      ],
      "results":[
        { "title":"用户ID", "name":"userId", "type":"String", "notnull":true },
        { "title":"用户名", "name":"username", "type":"String", "notnull":true }
      ]
    },
    {
      "id":"FLOW_NODE_DISPATCH_LOGGEDIN_USER",
      "type":"event",
      "title":"设置数据:登录用户",
      "reference":"Scaned/OnBindMobileNumber/FLOW_CODE_DISPATCH_LOGGEDIN_USER",
      "params":[
        { "title":"全局设置器", "name":"dispatch", "type":"Object", "notnull":true },
        { "title":"登录用户", "name":"loggedinUser", "type":"Object", "notnull":true }
      ]
    },
    {
      "id":"FLOW_NODE_JUMP_AND_SET_USER_DATA",
      "type":"event",
      "title":"跳转并设置用户数据",
      "reference":"Scaned/OnBindMobileNumber/FLOW_CODE_JUMP_AND_SET_USER_DATA",
      "params":[
        { "title":"用户ID", "name":"userId", "type":"String", "notnull":true },
        { "title":"用户名", "name":"username", "type":"String", "notnull":true }
      ],
      "results":[
        { "title":"登录用户", "name":"loggedinUser", "type":"Object", "notnull":true }
      ]
    }
  ],
  "routes":[
    { "source":"start", "target":"FLOW_NODE_GET_BINDING_PARAMETERS", "condition":"true" },
    { "source":"FLOW_NODE_GET_BINDING_PARAMETERS", "target":"@com.horsecoder.platform.mall.dialogue/FLOW_WE_CHAT_BINDING_PHONE_NUMBER_REGISTRATION", "condition":"true" },
    { "source":"@com.horsecoder.platform.mall.dialogue/FLOW_WE_CHAT_BINDING_PHONE_NUMBER_REGISTRATION", "target":"FLOW_NODE_JUMP_AND_SET_USER_DATA", "condition":"true" },
    { "source":"FLOW_NODE_JUMP_AND_SET_USER_DATA", "target":"FLOW_NODE_DISPATCH_LOGGEDIN_USER", "condition":"true" },
    { "source":"FLOW_NODE_DISPATCH_LOGGEDIN_USER", "target":"end", "condition":"true" }
  ]
}